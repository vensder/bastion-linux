# Bastion Linux minimal session.
# Keyboard only, no launcher: each app has its own key. Super = the Windows key.
#
#   Super+Enter    terminal (foot)
#   Super+E        Electrum
#   Super+B        LibreWolf (disposable sandbox)
#   Super+L        lock screen
#   Super+Q        close window
#   Super+F        fullscreen
#   Super+1..4     workspaces (Super+Shift+1..4 moves the window)
#   Super+arrows   move focus
#   Super+Shift+E  log out

set $mod Mod4
set $lock swaylock -f -c 000000

# No X server in this image; do not try to start one.
xwayland disable

output * bg #202020 solid_color
input type:keyboard {
    xkb_layout us
}

default_border pixel 2
focus_follows_mouse no

bindsym $mod+Return exec foot
bindsym $mod+e exec /usr/bin/electrum
bindsym $mod+b exec /usr/bin/librewolf-disposable
bindsym $mod+l exec $lock
bindsym $mod+q kill
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+e exec swaynag -t warning -m 'Log out?' -B 'Log out' 'swaymsg exit'

bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4

# Lock after 5 minutes idle and before suspend.
exec swayidle -w timeout 300 '$lock' before-sleep '$lock'

bar {
    position top
    status_command while date +'%Y-%m-%d %H:%M'; do sleep 30; done
}
