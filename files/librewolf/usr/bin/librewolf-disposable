#!/usr/bin/env bash
# Run LibreWolf in a disposable bubblewrap sandbox.
#
# Sees:     /usr, /etc, /sys (read-only), GPU, network, the Wayland socket,
#           and your Downloads folder (read-write, the only shared folder).
# Does not: your home folder (~/.electrum etc.), X11, the D-Bus session bus,
#           audio, other processes.
# Disposable: the browser's home is a tmpfs, so profile, cookies, cache and
#           history are gone when the window closes.
set -euo pipefail

: "${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR not set}"
: "${WAYLAND_DISPLAY:?not a Wayland session}"
WAYLAND_SOCKET="$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY"

# On Fedora Atomic /home is a symlink to /var/home; use the real path.
HOME_REAL=$(readlink -f "$HOME")
# Share only the user's Downloads folder, including a localised name.
# xdg-user-dir prints $HOME when no Downloads folder is configured.
DOWNLOADS=$(xdg-user-dir DOWNLOAD 2> /dev/null || true)
if [ -z "$DOWNLOADS" ] || [ "$(readlink -f "$DOWNLOADS")" = "$HOME_REAL" ]; then
    DOWNLOADS="$HOME/Downloads"
fi
mkdir -p "$DOWNLOADS"
DOWNLOADS=$(readlink -f "$DOWNLOADS")
USER_DIRS="$HOME_REAL/.config/user-dirs.dirs"

# DNS: /etc/resolv.conf is often a symlink into /run (systemd-resolved or
# NetworkManager); expose only the file it points to.
RESOLV_CONF=$(readlink -f /etc/resolv.conf)

# If the browser itself lives outside /usr, make that directory visible too.
BIN=""
for candidate in /usr/bin/librewolf /usr/share/librewolf/librewolf; do
    if [ -x "$candidate" ]; then BIN=$(readlink -f "$candidate"); break; fi
done
[ -n "$BIN" ] || { echo "librewolf binary not found" >&2; exit 1; }
EXTRA=()
case "$(dirname "$BIN")" in
    /usr/*) ;;
    *) EXTRA+=(--ro-bind "$(dirname "$BIN")" "$(dirname "$BIN")") ;;
esac

exec bwrap \
    --unshare-all --share-net \
    --die-with-parent --new-session \
    --ro-bind /usr /usr \
    --symlink usr/bin /bin --symlink usr/sbin /sbin \
    --symlink usr/lib /lib --symlink usr/lib64 /lib64 \
    --ro-bind /etc /etc \
    --ro-bind /sys /sys \
    --ro-bind-try "$RESOLV_CONF" "$RESOLV_CONF" \
    --proc /proc \
    --dev /dev \
    --tmpfs /dev/shm \
    --dev-bind-try /dev/dri /dev/dri \
    --tmpfs /tmp \
    --tmpfs /var \
    --symlink var/home /home \
    --tmpfs "$HOME_REAL" \
    --bind "$DOWNLOADS" "$DOWNLOADS" \
    --ro-bind-try "$USER_DIRS" "$USER_DIRS" \
    --dir "$XDG_RUNTIME_DIR" \
    --chmod 0700 "$XDG_RUNTIME_DIR" \
    --ro-bind "$WAYLAND_SOCKET" "$WAYLAND_SOCKET" \
    "${EXTRA[@]}" \
    --unsetenv DISPLAY \
    --unsetenv DBUS_SESSION_BUS_ADDRESS \
    --unsetenv SSH_AUTH_SOCK \
    --setenv MOZ_ENABLE_WAYLAND 1 \
    "$BIN" --no-remote "$@"
