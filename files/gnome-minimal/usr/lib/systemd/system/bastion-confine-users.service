[Unit]
Description=Bastion: confined SELinux users (group bastion-confined), no execution from home or /tmp
Documentation=file:///usr/libexec/bastion/confine-users.sh
ConditionSecurity=selinux
After=local-fs.target systemd-sysusers.service
# Deliberately not ordered before logins: the policy rebuild can take a while
# and must never block the login screen or text consoles. The mapping takes
# effect at the next login.
# To skip it for one boot, add to the kernel command line (GRUB, press e):
#   systemd.mask=bastion-confine-users.service

[Service]
Type=oneshot
RemainAfterExit=yes
Nice=10
TimeoutStartSec=15min
ExecStart=/usr/libexec/bastion/confine-users.sh

[Install]
WantedBy=multi-user.target
